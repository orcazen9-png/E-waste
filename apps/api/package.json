{
  "name": "@ewaste/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --experimental-transform-types --watch src/index.ts",
    "start": "node --experimental-transform-types src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-transform-types --test \"test/**/*.test.ts\"",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "db:seed": "node --experimental-transform-types prisma/seed.ts"
  },
  "dependencies": {
    "@ewaste/datasets": "workspace:*",
    "@ewaste/shared": "workspace:*",
    "@fastify/cors": "10.0.1",
    "@prisma/client": "5.22.0",
    "fastify": "5.1.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/node": "22.9.0",
    "prisma": "5.22.0",
    "typescript": "5.6.3"
  }
}

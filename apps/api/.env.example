# 'seed' runs entirely in memory off the synthetic dataset - no database needed.
DATA_SOURCE=seed
PORT=3001
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info

# Required only when DATA_SOURCE=postgres
# DATABASE_URL=postgresql://ewaste:ewaste@localhost:5432/ewaste

# Signs access tokens and keys one-time-passcode hashes.
# Rotating it signs everyone out. Required in production; the server refuses
# to start with the default value when NODE_ENV=production.
TOKEN_SECRET=dev-only-token-secret-change-me

# Salts the phone-number hash. Raw numbers are never stored, only this HMAC.
# Changing it orphans every existing collector, so set it once and keep it.
PHONE_SALT=dev-only-salt-change-me

# Returns one-time codes in API responses because no SMS provider is wired up.
# The server refuses to start with this enabled when NODE_ENV=production.
AUTH_DEV_MODE=true

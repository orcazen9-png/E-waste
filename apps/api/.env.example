# 'seed' runs entirely in memory off the synthetic dataset - no database needed.
DATA_SOURCE=seed
PORT=3001
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info

# Required only when DATA_SOURCE=postgres
# DATABASE_URL=postgresql://ewaste:ewaste@localhost:5432/ewaste

# Must be set to a real secret outside development.
PHONE_SALT=dev-only-salt-change-me
